rules_version = '2';

service cloud.firestore {

  // HELPERS
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner() {
    return isSignedIn() && (
      (resource != null && resource.data.createdBy == request.auth.uid) ||
      (request.resource != null && request.resource.data.createdBy == request.auth.uid)
    );
  }

  function isCollaborator() {
    return isSignedIn() &&
      ((resource != null && resource.data.collaborators != null && request.auth.uid in resource.data.collaborators) ||
      (request.resource != null && request.resource.data.collaborators != null && request.auth.uid in request.resource.data.collaborators));
  }

  function validateModule() {
    return request.resource.data.keys().hasAll(['title', 'description', 'createdBy', 'isPublic', 'tags', 'createdAt', 'updatedAt', 'stepCount'])
    && request.resource.data.title is string
    && request.resource.data.description is string
    && request.resource.data.isPublic is bool
    && request.resource.data.tags is list
    && request.resource.data.stepCount is int
    && (!('collaborators' in request.resource.data) || request.resource.data.collaborators is list)
    && (!('publishedVersion' in request.resource.data) || request.resource.data.publishedVersion is int)
    && (!('thumbnailUrl' in request.resource.data) || request.resource.data.thumbnailUrl is string);
  }

  function validateProgress() {
    return request.resource.data.keys().hasAll(['completedStepIds', 'lastViewedAt', 'quizScores', 'startedAt', 'completedAt'])
    && request.resource.data.completedStepIds is list
    && request.resource.data.quizScores is map
    && request.resource.data.lastViewedAt is timestamp
    && request.resource.data.startedAt is timestamp
    && (request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp);
  }

  function validateStep() {
    return request.resource.data.keys().hasAll(['title', 'type', 'order', 'createdBy', 'createdAt', 'updatedAt'])
    && request.resource.data.title is string
    && request.resource.data.type in ['video', 'quiz', 'flashcards', 'freeResponse', 'poll', 'additionalResources', 'sorting', 'debate']
    && request.resource.data.order is int
    && request.resource.data.createdBy is string
    && hasMatchingPayloadType()
    && validatePayload();
  }

  function hasMatchingPayloadType() {
    let t = request.resource.data.type;
    return (t == 'video' && 'youtubeUrl' in request.resource.data)
    || (t == 'quiz' && 'questions' in request.resource.data)
    || (t == 'flashcards' && 'cards' in request.resource.data)
    || (t == 'freeResponse' && 'prompt' in request.resource.data)
    || (t == 'poll' && 'question' in request.resource.data)
    || (t == 'additionalResources' && 'resources' in request.resource.data)
    || (t == 'sorting' && 'prompt' in request.resource.data)
    || (t == 'debate' && request.resource.data.keys().hasAll(['modulePrompt', 'startQuestion', 'maxStudentTurns']));
  }

  function validatePayload() {
    let t = request.resource.data.type;
    return (t == 'video' && validateVideoPayload())
    || (t == 'quiz' && validateQuizPayload())
    || (t == 'flashcards' && validateFlashcardsPayload())
    || (t == 'freeResponse' && validateFreeResponsePayload())
    || (t == 'poll' && validatePollPayload())
    || (t == 'additionalResources' && validateAdditionalResourcesPayload())
    || (t == 'sorting' && validateSortingPayload())
    || (t == 'debate' && validateDebatePayload());
  }

  function validateVideoPayload() {
    let d = request.resource.data;
    return d.youtubeUrl is string
      && (!('thumbnailUrl' in d) || d.thumbnailUrl is string)
      && (!('durationSec' in d) || d.durationSec is int);
  }

  function validateQuizPayload() {
    let d = request.resource.data;
    return d.shuffle is bool
      && d.questions is list
      && d.questions.size() > 0
      && d.questions[0].prompt is string
      && d.questions[0].choices is list
      && d.questions[0].correctIndex is int
      && (!('explanation' in d.questions[0]) || d.questions[0].explanation is string)
      && d.passingScore is int
      && d.passingScore >= 0
      && d.passingScore <= 100;
  }

  function validateFlashcardsPayload() {
    let d = request.resource.data;
    return d.cards is list
      && d.cards.size() > 0
      && d.cards[0].front is string
      && d.cards[0].back is string
      && (!('studyMode' in d) || d.studyMode in ['spaced', 'random']);
  }

  function validateFreeResponsePayload() {
    let d = request.resource.data;
    return d.prompt is string
      && (!('sampleAnswer' in d) || d.sampleAnswer is string)
      && (!('maxLength' in d) || (d.maxLength is int && d.maxLength > 0 && d.maxLength <= 10000));
  }

  function validatePollPayload() {
    let d = request.resource.data;
    return d.question is string
      && d.options is list
      && d.options.size() >= 2
      && d.options[0].id is string
      && d.options[0].text is string
      && d.options[0].votes is int
      && d.allowMultipleChoice is bool;
  }

  function validateSortingPayload() {
    let d = request.resource.data;
    return d.prompt is string
      && d.buckets is list
      && d.buckets.size() >= 2
      && d.buckets[0].id is string
      && d.buckets[0].label is string
      && d.cards is list
      && d.cards.size() > 0
      && d.cards[0].id is string
      && d.cards[0].text is string
      && (!('answerKey' in d) || d.answerKey is map);
  }

  function validateDebatePayload() {
    let d = request.resource.data;
    return d.modulePrompt is string
      && d.modulePrompt.size() > 0
      && d.startQuestion is string
      && d.startQuestion.size() > 0
      && d.maxStudentTurns is int
      && d.maxStudentTurns >= 3
      && d.maxStudentTurns <= 10;
  }

  function validateAdditionalResourcesPayload() {
    let d = request.resource.data;
    return d.resources is map
      && ('link' in d.resources || 'pdf' in d.resources)
      && (!('link' in d.resources) || d.resources.link is string)
      && (!('pdf' in d.resources) || d.resources.pdf is string);
  }

  function validateStepUpdate() {
    let allowedFields = [
      'title',
      'type',
      'order',
      'updatedAt',
      'createdBy',
      'createdAt',
      'estimatedMinutes',
      'isOptional',
      'moduleId',
      // Video fields
      'youtubeUrl',
      'thumbnailUrl',
      'durationSec',
      // Quiz fields
      'shuffle',
      'questions',
      'passingScore',
      // Flashcards fields
      'cards',
      'studyMode',
      // FreeResponse fields
      'prompt',
      'sampleAnswer',
      'maxLength',
      // Poll fields
      'question',
      'options',
      'allowMultipleChoice',
      // Additional Resources fields
      'resources',
      // Sorting fields
      'buckets',
      'answerKey',
      // Debate fields
      'modulePrompt',
      'startQuestion',
      'maxStudentTurns'
    ];
    return request.resource.data.keys().hasOnly(allowedFields)
      && request.resource.data.diff(resource.data).affectedKeys().size() > 0
      && (
        !('title' in request.resource.data) || request.resource.data.title is string
      )
      && (
        !('order' in request.resource.data) || request.resource.data.order is int
      )
      && (
        !('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp
      )
      && (
        !('type' in request.resource.data) || request.resource.data.type in ['video', 'quiz', 'flashcards', 'freeResponse', 'poll', 'additionalResources', 'sorting', 'debate']
      )
      && (
        resource.data.createdBy == request.resource.data.createdBy
      )
      && (
        resource.data.createdAt == request.resource.data.createdAt
      );
  }

  function validateModuleUpdate() {
    let allowedFields = [
      'title',
      'description',
      'isPublic',
      'tags',
      'updatedAt',
      'stepCount',
      'publishedVersion',
      'thumbnailUrl',
      'collaborators',
      'createdBy',
      'createdAt',
      'order'
    ];
    return request.resource.data.keys().hasOnly(allowedFields)
      && request.resource.data.diff(resource.data).affectedKeys().size() > 0
      && (
        !('title' in request.resource.data) || request.resource.data.title is string
      )
      && (
        !('description' in request.resource.data) || request.resource.data.description is string
      )
      && (
        !('isPublic' in request.resource.data) || request.resource.data.isPublic is bool
      )
      && (
        !('tags' in request.resource.data) || request.resource.data.tags is list
      )
      && (
        !('stepCount' in request.resource.data) || request.resource.data.stepCount is int
      )
      && (
        !('publishedVersion' in request.resource.data) || request.resource.data.publishedVersion is int
      )
      && (
        !('thumbnailUrl' in request.resource.data) || request.resource.data.thumbnailUrl is string
      )
      && (
        !('collaborators' in request.resource.data) || request.resource.data.collaborators is list
      )
      && (
        !('order' in request.resource.data) || request.resource.data.order is int
      )
      && resource.data.createdBy == request.resource.data.createdBy
      && resource.data.createdAt == request.resource.data.createdAt;
  }

  match /databases/{database}/documents {

      function isAdmin() {
        let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
        return request.auth != null
          && exists(userDocPath)
          && get(userDocPath).data.isAdmin == true;
      }

    // CLASSROOMS
    // Exact code reads are needed by the browser transactions; enumeration is denied.
    function validClassroomCode(code) {
      return code is string && code.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$');
    }

    function validTeacherClassroomIndex(data, classroomId, classroom) {
      return data.keys().hasAll(['classroomId', 'classroomName', 'role', 'joinCode', 'createdAt'])
        && data.keys().hasOnly(['classroomId', 'classroomName', 'role', 'joinCode', 'createdAt'])
        && data.classroomId == classroomId
        && data.classroomName == classroom.name
        && data.role == 'teacher'
        && data.joinCode == classroom.joinCode
        && data.createdAt == request.time;
    }

    function validStudentClassroomIndex(data, classroomId, classroom) {
      return data.keys().hasAll(['classroomId', 'classroomName', 'role', 'teacherId', 'joinedAt'])
        && data.keys().hasOnly(['classroomId', 'classroomName', 'role', 'teacherId', 'joinedAt'])
        && data.classroomId == classroomId
        && data.classroomName == classroom.name
        && data.role == 'student'
        && data.teacherId == classroom.teacherId
        && data.joinedAt == request.time;
    }

    function validClassroomCreation(classroomId) {
      let classroom = getAfter(/databases/$(database)/documents/classrooms/$(classroomId)).data;
      let codePath = /databases/$(database)/documents/classroomJoinCodes/$(classroom.joinCode);
      let indexPath = /databases/$(database)/documents/users/$(request.auth.uid)/classrooms/$(classroomId);
      let code = getAfter(codePath).data;
      return classroom.keys().hasAll(['id', 'name', 'teacherId', 'teacherDisplayName', 'joinCode', 'studentCount', 'isArchived', 'createdAt', 'updatedAt'])
        && classroom.keys().hasOnly(['id', 'name', 'teacherId', 'teacherDisplayName', 'joinCode', 'studentCount', 'isArchived', 'createdAt', 'updatedAt'])
        && classroom.id == classroomId
        && classroom.name is string && classroom.name.size() >= 1 && classroom.name.size() <= 80
        && classroom.name.matches('.*[^\\s].*')
        && classroom.teacherId == request.auth.uid
        && classroom.teacherDisplayName is string
        && validClassroomCode(classroom.joinCode)
        && classroom.studentCount is int && classroom.studentCount == 0
        && classroom.isArchived == false
        && classroom.createdAt == request.time && classroom.updatedAt == request.time
        && !exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && !exists(codePath) && !exists(indexPath)
        && code.keys().hasAll(['classroomId', 'teacherId', 'isArchived', 'createdAt'])
        && code.keys().hasOnly(['classroomId', 'teacherId', 'isArchived', 'createdAt'])
        && code.classroomId == classroomId && code.teacherId == request.auth.uid
        && code.isArchived == false && code.createdAt == request.time
        && validTeacherClassroomIndex(getAfter(indexPath).data, classroomId, classroom);
    }

    // Validate the whole join so member, index and count cannot be written separately.
    function validClassroomJoin(classroomId, userId) {
      let classroomPath = /databases/$(database)/documents/classrooms/$(classroomId);
      let memberPath = /databases/$(database)/documents/classrooms/$(classroomId)/members/$(userId);
      let indexPath = /databases/$(database)/documents/users/$(userId)/classrooms/$(classroomId);
      let classroom = get(classroomPath).data;
      let after = getAfter(classroomPath).data;
      let member = getAfter(memberPath).data;
      let code = get(/databases/$(database)/documents/classroomJoinCodes/$(classroom.joinCode)).data;
      return userId == request.auth.uid && classroom.teacherId != userId
        && classroom.isArchived == false && code.isArchived == false
        && code.classroomId == classroomId && code.teacherId == classroom.teacherId
        && !exists(memberPath) && !exists(indexPath)
        && member.keys().hasAll(['userId', 'role', 'displayName', 'email', 'joinedWithCode', 'joinedAt', 'status'])
        && member.keys().hasOnly(['userId', 'role', 'displayName', 'email', 'joinedWithCode', 'joinedAt', 'status'])
        && member.userId == userId && member.role == 'student' && member.status == 'active'
        && member.displayName is string && member.email is string
        && member.joinedWithCode == classroom.joinCode
        && member.joinedAt == request.time
        && after.diff(classroom).affectedKeys().hasOnly(['studentCount', 'updatedAt'])
        && after.studentCount is int && after.studentCount == classroom.studentCount + 1
        && after.updatedAt == request.time
        && validStudentClassroomIndex(getAfter(indexPath).data, classroomId, classroom);
    }

    match /classrooms/{classroomId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && validClassroomCreation(classroomId);
      allow update: if isSignedIn() && validClassroomJoin(classroomId, request.auth.uid);
      allow delete: if false;

      match /members/{userId} {
        allow get: if isSignedIn() && (request.auth.uid == userId
          || get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid);
        allow list: if isSignedIn()
          && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid;
        allow create: if isSignedIn() && validClassroomJoin(classroomId, userId);
        allow update, delete: if false;
      }
      // /polls/{pollId} is reserved for a future classroom-polls feature (default deny).
    }

    match /classroomJoinCodes/{joinCode} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && validClassroomCode(joinCode)
        && getAfter(/databases/$(database)/documents/classrooms/$(request.resource.data.classroomId)).data.joinCode == joinCode
        && validClassroomCreation(request.resource.data.classroomId);
      allow update, delete: if false;
    }

    // UPLOADED FILES
    match /uploadedFiles/{fileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                   && request.resource.data.userId == request.auth.uid
                   && request.resource.data.keys().hasAll(['fileName', 'fileSize', 'contentType', 'userId', 'uploadedAt'])
                   && request.resource.data.fileName is string
                   && request.resource.data.fileSize is int
                   && request.resource.data.contentType is string
                   && request.resource.data.userId is string
                   && request.resource.data.uploadedAt is timestamp
                   && (!('moduleId' in request.resource.data) || request.resource.data.moduleId is string)
                   && (!('stepType' in request.resource.data) || request.resource.data.stepType is string)
                   && (!('url' in request.resource.data) || request.resource.data.url is string);
      allow delete: if isSignedIn()
                   && resource.data.userId == request.auth.uid;
    }

    // MODULES
    match /modules/{moduleId} {
      allow read: if (resource.data.isPublic != null && resource.data.isPublic == true) || isOwner() || isCollaborator() || isAdmin();
      allow create: if isSignedIn() && validateModule() && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isOwner() || isCollaborator() || isAdmin()) && validateModuleUpdate();
      allow delete: if isOwner() || isCollaborator() || isAdmin();

      // Debate permissions come from the persisted parent module, not the step author.
      function canEditDebates() {
        let module = get(/databases/$(database)/documents/modules/$(moduleId)).data;
        return isSignedIn() && (
          module.createdBy == request.auth.uid
          || ('collaborators' in module && request.auth.uid in module.collaborators)
          || isAdmin()
        );
      }

      // DEBATE STEPS
      match /debates/{debateId} {
        allow read: if get(/databases/$(database)/documents/modules/$(moduleId)).data.isPublic == true
          || canEditDebates();
        allow create: if canEditDebates()
          && request.resource.data.type == 'debate'
          && validateStep();
        allow update: if canEditDebates()
          && request.resource.data.type == 'debate'
          && validateStep()
          && validateStepUpdate();
        allow delete: if canEditDebates();
      }

      // VIDEO STEPS
      match /videos/{videoId} {
        allow read: if get(/databases/$(database)/documents/modules/$(moduleId)).data.isPublic == true || isOwner() || isCollaborator() || isAdmin();
        allow create: if (isOwner() || isCollaborator() || isAdmin()) && validateStep();
        allow update: if (isOwner() || isCollaborator() || isAdmin()) && validateStepUpdate();
        allow delete: if isOwner() || isCollaborator() || isAdmin();
      }

      // QUIZ STEPS
      match /quizzes/{quizId} {
        allow read: if get(/databases/$(database)/documents/modules/$(moduleId)).data.isPublic == true || isOwner() || isCollaborator() || isAdmin();
        allow create: if (isOwner() || isCollaborator() || isAdmin()) && validateStep();
        allow update: if (isOwner() || isCollaborator() || isAdmin()) && validateStepUpdate();
        allow delete: if isOwner() || isCollaborator() || isAdmin();
      }

      // FLASHCARD STEPS
      match /flashcards/{flashcardId} {
        allow read: if get(/databases/$(database)/documents/modules/$(moduleId)).data.isPublic == true || isOwner() || isCollaborator() || isAdmin();
        allow create: if (isOwner() || isCollaborator() || isAdmin()) && validateStep();
        allow update: if (isOwner() || isCollaborator() || isAdmin()) && validateStepUpdate();
        allow delete: if isOwner() || isCollaborator() || isAdmin();
      }

      // FREE RESPONSE STEPS
      match /freeResponses/{freeResponseId} {
        allow read: if get(/databases/$(database)/documents/modules/$(moduleId)).data.isPublic == true || isOwner() || isCollaborator() || isAdmin();
        allow create: if (isOwner() || isCollaborator() || isAdmin()) && validateStep();
        allow update: if (isOwner() || isCollaborator() || isAdmin()) && validateStepUpdate();
        allow delete: if isOwner() || isCollaborator() || isAdmin();
      }

      // SORTING STEPS
      match /sorting/{sortingId} {
        allow read: if get(/databases/$(database)/documents/modules/$(moduleId)).data.isPublic == true || isOwner() || isCollaborator() || isAdmin();
        allow create: if (isOwner() || isCollaborator() || isAdmin()) && validateStep();
        allow update: if (isOwner() || isCollaborator() || isAdmin()) && validateStepUpdate();
        allow delete: if isOwner() || isCollaborator() || isAdmin();
      }

      // POLL STEPS
      match /polls/{pollId} {
        allow read: if get(/databases/$(database)/documents/modules/$(moduleId)).data.isPublic == true || isOwner() || isCollaborator() || isAdmin();
        allow create: if (isOwner() || isCollaborator() || isAdmin()) && validateStep();
        // Allow owner/collaborator/admin to do full step updates (reorder, edit, etc.)
        // Also allow any signed-in user to update poll votes (only options + updatedAt)
        allow update: if ((isOwner() || isCollaborator() || isAdmin()) && validateStepUpdate())
          || (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'updatedAt']) &&
          request.resource.data.options is list &&
          request.resource.data.updatedAt is timestamp);
        allow delete: if isOwner() || isCollaborator() || isAdmin();
      }

      // ADDITIONAL RESOURCES STEPS
      match /additionalResources/{resourceId} {
        allow read: if get(/databases/$(database)/documents/modules/$(moduleId)).data.isPublic == true || isOwner() || isCollaborator() || isAdmin();
        allow create: if (isOwner() || isCollaborator() || isAdmin()) && validateStep();
        allow update: if (isOwner() || isCollaborator() || isAdmin()) && validateStepUpdate();
        allow delete: if isOwner() || isCollaborator() || isAdmin();
      }
    }

    // CONFIG
    match /config/settings {
      allow read: if isAdmin();
      allow write: if false;
    }

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if request.auth.uid == userId;
      allow update: if isAdmin()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAdmin']);

      // The index provides discovery without listing the classrooms collection.
      match /classrooms/{classroomId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && (
          (request.resource.data.role == 'teacher' && validClassroomCreation(classroomId))
          || (request.resource.data.role == 'student' && validClassroomJoin(classroomId, userId))
        );
        allow update, delete: if false;
      }

      // PROGRESS
      match /progress/{moduleId} {
        allow write: if isSignedIn() && request.auth.uid == userId && validateProgress();
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isAdmin();
      }

      // AI sessions are private; only the backend Admin SDK may write them.
      match /debateSessions/{sessionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      // JOURNAL
      match /journal/{entryId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
